# ==============================
# SUPABASE
# ==============================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================
# LLM CLOUD — Cascada Tri-Fallover (solo nube)
# groq (primario) -> gemini (secundario) -> template (offline deterministico)
# ==============================
LLM_PROVIDER=groq
LLM_PROVIDER_ORDER=groq,gemini,template
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=10
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12
LLM_TIMEOUT=30

# ==============================
# ALERTAS — Resend (primario) via Supabase Webhook
# Fase n8n→Resend: INSERT scan_results dispara Edge Function
# supabase/functions/send-malware-alert → Resend API
# ==============================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=ShadowNet Defender <onboarding@resend.dev>
RESEND_REPLY_TO=shadownettechnology@gmail.com
# SUPABASE_URL y SERVICE_ROLE ya definidos arriba; Edge Function los usa como secrets:
# supabase secrets set RESEND_API_KEY=re_xxx RESEND_FROM="..." SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=...

# ==============================
# n8n — DEPRECATED / fallback rollback (Fase 3)
# Mantener deshabilitado tras validar Resend; no eliminar hasta 2 semanas staging
# ==============================
N8N_ENABLED=false
# N8N_WEBHOOK_TEST=https://xxx.ngrok-free.dev/webhook-test/shadownet-malware
# N8N_WEBHOOK_PROD=https://xxx.ngrok-free.dev/webhook/shadownet-malware
# N8N_TIMEOUT_SECONDS=8
# N8N_ALERT_ON_STATUS=DANGEROUS,SUSPICIOUS
# N8N_ALERT_ON_LABEL_ONLY=false
# ENVIRONMENT ya controla webhook test vs prod (dev→test, prod→production)

# ==============================
# APP
# ==============================
MAX_UPLOAD_MB=200
ENVIRONMENT=dev
