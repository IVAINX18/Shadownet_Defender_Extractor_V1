# ==============================
# SUPABASE
# ==============================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================
# LLM CLOUD — Cascada Tri-Fallover (solo nube)
# groq (primario) -> gemini (secundario) -> template (offline deterministico)
# ==============================
LLM_PROVIDER=groq
LLM_PROVIDER_ORDER=groq,gemini,template
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=10
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12
LLM_TIMEOUT=30

# ==============================
# ALERTAS — Gmail SMTP (primario) via Supabase Webhook + Edge Function
# Flujo: INSERT scan_results → Database Webhook → supabase/functions/send-malware-alert
#   → Nodemailer → smtp.gmail.com (STARTTLS 587) → usuario registrado.
# Los secrets se setean SOLO en Supabase (Dashboard o CLI), NUNCA en este archivo:
#   supabase secrets set SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=<app_password>
#   supabase secrets set SB_URL=https://<PROJECT>.supabase.co SB_SERVICE_ROLE_KEY=<service_role>
# Recipiente: scan_results.user_email (fallback users.email via user_id). Idempotencia: alert_sent.
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shadownettechnology@gmail.com
# SMTP_PASS se define como Supabase Secret, no en este archivo.

# ==============================
# ALERTAS (legacy) — Resend DEPRECATED / no usado por send-malware-alert
# Secrets conservados para transición; la Edge Function ya NO llama a api.resend.com.
# ==============================
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM=ShadowNet Defender <onboarding@resend.dev>
# RESEND_REPLY_TO=shadownettechnology@gmail.com

# ==============================
# n8n — DEPRECATED / fallback rollback (Fase 3)
# Mantener deshabilitado tras validar Resend; no eliminar hasta 2 semanas staging
# ==============================
N8N_ENABLED=false
# N8N_WEBHOOK_TEST=https://xxx.ngrok-free.dev/webhook-test/shadownet-malware
# N8N_WEBHOOK_PROD=https://xxx.ngrok-free.dev/webhook/shadownet-malware
# N8N_TIMEOUT_SECONDS=8
# N8N_ALERT_ON_STATUS=DANGEROUS,SUSPICIOUS
# N8N_ALERT_ON_LABEL_ONLY=false
# ENVIRONMENT ya controla webhook test vs prod (dev→test, prod→production)

# ==============================
# APP
# ==============================
MAX_UPLOAD_MB=200
ENVIRONMENT=dev
