[Unit]
Description=ShadowNet Defender — Backend de análisis de malware
Documentation=https://github.com/IVAINX18/Shadownet_Defender_Extractor_V2
After=network-online.target
Wants=network-online.target

[Service]
# ── Identidad ────────────────────────────────────────────────────────────────
User=shadownet
Group=shadownet
WorkingDirectory=/opt/shadownet

# ── Variables de entorno ──────────────────────────────────────────────────────
# El archivo .env contiene SUPABASE_KEY, SUPABASE_JWT_SECRET, N8N_WEBHOOK_PROD, etc.
EnvironmentFile=/opt/shadownet/.env

# ── Pre-check: verificar que el modelo ONNX existe antes de arrancar ──────────
ExecStartPre=/bin/bash -c 'test -f /opt/shadownet/models/best_model.onnx || \
    (echo "ERROR: Modelo ONNX no encontrado en /opt/shadownet/models/best_model.onnx" && exit 1)'
ExecStartPre=/bin/bash -c 'test -f /opt/shadownet/models/scaler.pkl || \
    (echo "ERROR: Scaler no encontrado en /opt/shadownet/models/scaler.pkl" && exit 1)'

# ── Arranque ──────────────────────────────────────────────────────────────────
ExecStart=/opt/shadownet/.venv/bin/python3 -m uvicorn \
    backend.app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --access-log

# ── Reinicio ──────────────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

# ── Seguridad (hardening) ──────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/shadownet/quarantine /opt/shadownet/data /opt/shadownet/logs
CapabilityBoundingSet=
AmbientCapabilities=

# ── Logs ───────────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shadownet

# ── Timeout ───────────────────────────────────────────────────────────────────
TimeoutStartSec=30s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
